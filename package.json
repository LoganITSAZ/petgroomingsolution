{
  "name": "gentlegroomer",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node_modules/.bin/tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:raw": "next dev",
    "build": "next build",
    "build:check": "NEXT_DIST_DIR=.next-check next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "staff:password": "tsx scripts/reset-password.ts",
    "db:demo": "tsx prisma/demo.ts",
    "jobs:once": "tsx scripts/jobs.ts once",
    "jobs:loop": "tsx scripts/jobs.ts loop",
    "dev:test": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://postgres@localhost:5432/gentlegroomer_test}\" node scripts/dev-server.mjs",
    "db:test:reset": "bash scripts/test-db.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/jquery": "^4.0.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jquery": "^4.0.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
