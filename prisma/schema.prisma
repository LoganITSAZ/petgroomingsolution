// Pet grooming shop management schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// SYSTEM CONFIG (single-row shop-wide settings)
// ─────────────────────────────────────────────
model SystemConfig {
  id String @id @default("global") // enforces single row

  // Shop identity
  shopTagline String? // shared home-page tagline and public-site banner
  shopName    String  @default("Your Grooming Shop")
  shopPhone   String?
  shopEmail   String?
  shopAddress String?
  shopWebsite String?

  // Feature flags (toggle per deployment)
  featureOnlineBooking        Boolean @default(true) // customers can book via portal
  featureWalkInPortal         Boolean @default(true) // customers can check in walk-ins via portal
  featureEmailNotify          Boolean @default(true) // send email on booking + ready pickup
  featureSmsNotify            Boolean @default(false) // send SMS (requires Twilio config)
  featureWaiverRequired       Boolean @default(true) // require liability waiver on first signup
  featureRewards              Boolean @default(false) // visit punch card for customers
  /// Before/after and issue photos on a visit. On by default: a shop that
  /// never uploads sees an empty strip, and photos already taken stay
  /// readable when it is switched off.
  featureVisitPhotos          Boolean @default(true)
  /// Per-vaccine records with expiry dates, and the check that reads them.
  /// On by default, but it gates nothing until the shop adds a requirement
  /// row -- no rows means no gate.
  featureVaccinationGate      Boolean @default(true)
  /// The day-before reminder. On by default: a shop with email switched off
  /// sends nothing anyway, so this decides intent rather than capability.
  featureAppointmentReminders Boolean @default(true)
  /// The nudge for a household that is past its own usual gap between
  /// grooms. Measured from their history, so it says nothing about a
  /// customer with fewer than three visits on file.
  featureRebookingPrompts     Boolean @default(true)
  /// The ticket at the counter: surcharges found on the table, what was paid,
  /// the tip, and the day's takings. The shop's own Clover terminal takes the
  /// money -- these rows record it.
  featureCounterPayments      Boolean @default(true)
  /// The morning brief: what the shop's own records say about today, mailed to
  /// whoever runs it. Off by default -- it is mail to staff, and a shop that
  /// has not asked for a daily email should not start receiving one on upgrade.
  featureDailyDigest          Boolean @default(false)
  /// The offer that goes out when a booked visit is cancelled and the slot is
  /// still sellable. Off by default: it texts customers who did not ask to be
  /// contacted about somebody else's cancellation.
  featureSlotOffers           Boolean @default(false)
  /// Testimonials on the public home page, and the form customers write them
  /// in. Off by default: a shop that has collected nothing should not publish
  /// an empty section, and nothing is shown until a manager approves it.
  featureTestimonials         Boolean @default(false)

  // Liability waiver
  waiverText    String? @db.Text // full waiver body; null = feature off even if flag is true
  waiverVersion String? // e.g. "1.0" — bump to re-prompt existing customers

  // Business hours (JSON: { monday: { open: "08:00", close: "15:00" } | null, ... })
  businessHours Json?

  // Notification settings
  // No sender-name column: emails go out as the shop name (SystemConfig.shopName).
  emailFromAddress String? // e.g. "no-reply@gentlegroomer.net"
  // Twilio, typed in at /admin/notifications. Null until SMS is configured.
  //
  // These are stored in cleartext, and the comment here used to claim they were
  // encrypted. They are not, and encrypting them at rest would not help: the app
  // has to present the token to Twilio on every send, so the key would sit in
  // the same deployment as the ciphertext. The database is the trust boundary —
  // back it up accordingly, and rotate the token if it is ever exposed.
  twilioAccountSid String?
  twilioAuthToken  String?
  twilioFromNumber String?

  // Public site appearance
  themePreset        String  @default("default") // id from lib/themes.ts
  themeAutoSeasonal  Boolean @default(false) // follow the calendar instead
  themeUseShopColors Boolean @default(true)
  themeBrandColor    String? // legacy base color for shops without a full palette
  themeShopColors    Json? // hex colors keyed by the 13 template color roles

  // How late an arrival may be before the schedule flags it. Green until the
  // first threshold, then amber, orange and finally treated as missed.
  lateArrivalWatchMins  Int @default(5)
  lateArrivalLateMins   Int @default(15)
  lateArrivalMissedMins Int @default(30)

  // How long a finished pet may wait before the shop is nudged. Three levels,
  // so a short wait reads differently from one that is becoming a problem.
  pickupWatchMins    Int @default(60)
  pickupLateMins     Int @default(120)
  pickupCriticalMins Int @default(240)

  // Scheduling: the week past which scheduled hours read as overtime.
  overtimeWeeklyHours Int @default(40)

  // Rewards. Punches are finished visits; every `rewardVisitsPerReward` of
  // them earns one `rewardLabel` to hand over at the counter.
  rewardVisitsPerReward Int    @default(8)
  rewardLabel           String @default("A free nail trim")
  // What one earned reward takes off a bill. Rewards are counted in visits,
  // but they are paid out in money: a cash amount is the only thing that
  // applies cleanly to a visit carrying several services.
  rewardValueCents      Int    @default(1000)

  // Vaccinations. The gate warns by default: a shop that upgrades with no
  // records on file must not find its diary refusing every booking.
  /// True refuses a customer-facing booking for a pet whose shots have
  /// lapsed. Staff at the counter are never refused either way.
  vaccinationGateBlocks Boolean @default(false)
  /// Days past an expiry the shop will still take a booking, for an owner
  /// who is on their way to the vet. Moves what blocks, not what is shown.
  vaccinationGraceDays  Int     @default(0)

  // Reminders
  /// How far ahead of a visit the reminder goes out. A visit closer than
  /// `bookingLeadHours` is skipped -- an hour's notice is noise.
  reminderHoursBefore Int @default(24)

  // Rebooking
  /// Days past a household's own cadence before the shop says anything. A
  /// customer who books every eight weeks is not overdue on day 57.
  rebookingGraceDays Int @default(7)

  // The morning brief
  /// Shop-local hour the digest goes out. Before the doors open, so it is read
  /// with the first coffee rather than found at lunchtime.
  digestHour       Int     @default(7)
  /// Shop day key (`YYYY-MM-DD`) the digest last went out for. One column
  /// rather than a run-state table: the job is once a day and this is the
  /// whole of what it must remember not to repeat.
  digestLastSentOn String?

  // Filling a cancelled slot
  /// How many households one freed slot is offered to. A cancellation is one
  /// slot; texting forty people about it is how a shop trains its customers to
  /// ignore its messages.
  slotOfferMaxRecipients Int @default(5)
  /// How far either side of the freed slot a household's own due date may fall
  /// and still be offered it.
  slotOfferWindowDays    Int @default(10)

  // Payroll
  defaultCommissionPercent Float @default(40) // percent of ticket paid to the groomer

  // Booking rules
  bookingLeadHours  Int    @default(2) // min hours in advance a customer can book
  bookingWindowDays Int    @default(30) // how many days ahead customers can book
  walkInWindowStart String @default("09:00") // walk-in services available from
  walkInWindowEnd   String @default("15:00") // walk-in services available until

  // Payment processing
  /// Which processor takes card payments. The key itself is an environment
  /// variable -- see docs/superpowers/specs/2026-09-15-card-payments-at-the-register-design.md
  paymentProvider PaymentProvider?

  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// ─────────────────────────────────────────────
// STAFF (internal users — groomers, admins)
// ─────────────────────────────────────────────
model Staff {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  passwordHash    String
  // A person can hold several roles at once — groomer who also baths, admin
  // who still works the floor. ADMIN is what unlocks the admin panel.
  roles           StaffRole[]     @default([GROOMER])
  isActive        Boolean         @default(true)
  themePreference ThemePreference @default(SYSTEM)
  photoId         String?

  // Percent of the services they finish that they are paid. Null falls back to
  // SystemConfig.defaultCommissionPercent.
  commissionPercent Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Where this person normally works. Assignments default to it.
  defaultStationId String?

  // Whether they are on the floor right now. "Working" is not stored — it is
  // derived from having a pet in hand.
  presence      StaffPresence @default(OFF_SHIFT)
  presenceSince DateTime      @default(now())

  defaultStation       Station?                   @relation("HomeStation", fields: [defaultStationId], references: [id])
  photo                Photo?                     @relation(fields: [photoId], references: [id], onDelete: SetNull)
  preferredByCustomers Customer[]                 @relation("PreferredGroomer")
  appointments         Appointment[]
  statusHistory        AppointmentStatusHistory[]
  visitEvents          VisitEvent[]
  visitPhotos          VisitPhoto[]
  waiverRevisions      WaiverRevision[]
  StaffPresenceEvent   StaffPresenceEvent[]
  StaffShift           StaffShift[]

  rewardRedemptions    RewardRedemption[]
  vaccinationsVerified PetVaccination[]
  surchargesAdded      AppointmentSurcharge[]
  paymentsTaken        Payment[]
  insightDecisions     InsightDecision[]
  paymentAttempts      PaymentAttempt[]

  @@map("staff")
}

enum StaffPresence {
  OFF_SHIFT // signed off for the day
  READY // on the floor and free to take a pet
  BREAK // away on a break
  RESTROOM // stepped out briefly
}

// A dated shift. Recurring rotas are generated into rows rather than stored as
// a pattern: the shop edits individual days constantly, and a concrete row is
// what every screen actually needs.
model StaffShift {
  id       String   @id @default(cuid())
  staffId  String
  startsAt DateTime
  endsAt   DateTime
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
  @@index([startsAt])
  @@map("staff_shifts")
}

// Append-only record of presence changes, so a shift can be reconstructed.
model StaffPresenceEvent {
  id        String        @id @default(cuid())
  staffId   String
  presence  StaffPresence
  changedAt DateTime      @default(now())
  note      String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, changedAt])
  @@map("staff_presence_events")
}

enum StaffRole {
  ADMIN // full access, including the technical screens
  MANAGER // runs the shop: everything in the admin panel except the technical screens
  GROOMER // grooms pets
  BATHER // bathing and prep
}

// ─────────────────────────────────────────────
// BREED GUIDE (grooming reference, editable by the shop)
// ─────────────────────────────────────────────
// A job aid at the station, not a rulebook: seeded with widely documented coat
// characteristics and kept current by whoever actually grooms them.
model BreedGuide {
  id      String    @id @default(cuid())
  breed   String    @unique
  species Species   @default(DOG)
  coat    CoatType?

  // What to expect from the coat and the groom.
  summary     String  @db.Text
  // Bullet points, one per line, shown at the station.
  tips        String  @db.Text
  // Typical time this breed takes, when it differs from the service default.
  typicalMins Int?
  // A stock photo of the breed, by URL. Not a pet's photo, so it is not in the
  // `Photo` table: nothing private, nothing to serve behind auth, and the shop
  // can point it at any picture it likes.
  photoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("breed_guides")
}

// A customer's own words, shown on the public home page. The shop types these
// in from what it has been sent or told — there is no review system here, and
// building one would need moderation, verification and somewhere to dispute a
// bad one.
model Testimonial {
  id String @id @default(cuid())

  quote   String  @db.Text
  // How the shop credits it — "Maria R." — not a Customer row: a testimonial
  // outlives the account, and may come from someone who never had one.
  author  String
  // The pet, when there is one. Reads as "Maria R. · Bailey".
  petName String?

  // Out of five, when they gave one. Optional because the shop types older
  // testimonials in from cards and emails that never carried a number.
  rating Int?

  // Set when a customer wrote it themselves, so the screen can say who is
  // being quoted is really them. Null means the shop typed it in.
  // `SetNull`, not cascade: a published quote outlives a closed account.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Nothing reaches the public site unapproved. The shop's own entries are
  // approved as they are written; a customer's sit in the queue until a
  // manager reads them. Clearing this puts one back in the queue.
  approvedAt DateTime?

  // Approved and still wanted. The pair is three states: unapproved (queued),
  // approved and active (published), approved and inactive (taken down) --
  // which is what lets the shop pull a quote without re-reviewing it later.
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvedAt, isActive, sortOrder])
  @@map("testimonials")
}

// ─────────────────────────────────────────────
// PHOTOS (small profile images, stored in the database)
// ─────────────────────────────────────────────
// Kept in Postgres rather than on disk: one volume to back up, nothing to lose
// on redeploy, and these are a few hundred kilobytes each.
model Photo {
  id        String   @id @default(cuid())
  mimeType  String
  byteSize  Int
  data      Bytes
  createdAt DateTime @default(now())

  customers   Customer[]
  staff       Staff[]
  pets        Pet[]
  visitPhotos VisitPhoto[]

  @@map("photos")
}

// ─────────────────────────────────────────────
// CUSTOMERS (pet owners — portal users)
// ─────────────────────────────────────────────
model Customer {
  id              String          @id @default(cuid())
  firstName       String
  lastName        String
  email           String          @unique
  phone           String?
  /// Opt-*out*, not opt-in: a number given to the shop so it can say the dog is
  /// ready is a number the shop may use for that. Existing customers would all
  /// start silenced under an opt-in column, which is not what either side
  /// expects. Every message carries the STOP line that sets this.
  smsOptOut       Boolean         @default(false)
  passwordHash    String
  isActive        Boolean         @default(true)
  themePreference ThemePreference @default(SYSTEM)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // The groomer this customer books with. Bookings default to them, and they
  // default to their own station.
  preferredStaffId String?
  photoId          String? // optional headshot, so staff recognise them

  // Where they are. Free text: the shop writes addresses the way it says them,
  // and geocoding is a lookup on top rather than a set of typed columns.
  address String?

  // The rate this customer is on. Null means the published catalog price.
  pricingTierId String?
  // Why this customer is priced the way they are — read at the counter.
  pricingNotes  String? @db.Text

  photo             Photo?             @relation(fields: [photoId], references: [id], onDelete: SetNull)
  preferredStaff    Staff?             @relation("PreferredGroomer", fields: [preferredStaffId], references: [id])
  pricingTier       PricingTier?       @relation(fields: [pricingTierId], references: [id], onDelete: SetNull)
  pets              Pet[]
  // Everyone else the owner has approved to drop off or collect their pets.
  alternateContacts AlternateContact[]
  appointments      Appointment[]
  waiverAcceptances WaiverAcceptance[]
  rewardEarnings    RewardEarning[]
  rewardRedemptions RewardRedemption[]
  notifications     NotificationLog[]
  testimonials      Testimonial[]

  @@map("customers")
}

// Someone besides the owner who may hand over or collect a pet.
//
// A household has more than one — a partner, a dog walker, a neighbour — so
// they are rows rather than the three columns on the customer they replaced.
model AlternateContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  phone      String?
  email      String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("alternate_contacts")
}

enum ThemePreference {
  /// Follow the device. Nothing is stored about which way it resolved — the
  /// browser decides at paint time, so a laptop that dims at sunset takes the
  /// back office with it without anyone visiting their profile.
  SYSTEM
  LIGHT
  DARK
}

// ─────────────────────────────────────────────
// PETS (profiles for dogs, cats, etc.)
// ─────────────────────────────────────────────
model Pet {
  id                      String    @id @default(cuid())
  customerId              String
  name                    String
  species                 Species   @default(DOG)
  sex                     PetSex    @default(UNKNOWN)
  breed                   String?
  dateOfBirth             DateTime?
  weightLbs               Float?
  coatType                CoatType?
  temperamentNotes        String? // e.g. "nervous around other animals, loves treats"
  healthFlags             String[] // e.g. ["elderly", "reactive", "allergy:chicken"]
  /// When the shop last saw proof of vaccination. Null is "not confirmed" —
  /// a date rather than a flag, because a record seen two years ago is the
  /// question the counter actually asks.
  vaccinationsConfirmedAt DateTime?
  groomingNotes           String? // standing instructions for every visit
  hasBiteHistory          Boolean   @default(false) // true if pet has ever bitten a groomer
  /// Who to ring when something is wrong with the pet rather than the groom.
  /// Free text like every other contact here: a shop writes down whatever the
  /// owner says, which is often a practice rather than a named vet.
  vetName                 String?
  vetPhone                String?
  photoUrl                String? // external image, if the shop uses one
  photoId                 String? // uploaded photo held in the database
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  customer     Customer         @relation(fields: [customerId], references: [id])
  photo        Photo?           @relation(fields: [photoId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  vaccinations PetVaccination[]

  @@map("pets")
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum Species {
  DOG
  CAT
  OTHER
}

// ─────────────────────────────────────────────
// VACCINATIONS (what the shop checks, and what it has seen)
// ─────────────────────────────────────────────

/// What this shop requires, per species. No rows means no gate: a shop that
/// checks nothing is never asked to switch anything off, and a shop that
/// checks only rabies has one row.
model VaccineRequirement {
  id        String   @id @default(cuid())
  /// What the shop calls it on the certificate: "Rabies", "Bordetella".
  name      String
  species   Species  @default(DOG)
  /// Retiring a requirement leaves the records behind it readable.
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records PetVaccination[]

  @@unique([name, species])
  @@map("vaccine_requirements")
}

/// One row per pet per requirement. A renewal updates the row rather than
/// stacking history: the shop's question is always "is this pet current",
/// and a pile of expired rows is a document archive this app is not.
model PetVaccination {
  id            String    @id @default(cuid())
  petId         String
  requirementId String
  /// The date on the certificate. Null means proof was seen with no date on
  /// it, which counts as current but never expires -- so it is flagged.
  expiresOn     DateTime?
  verifiedAt    DateTime  @default(now())
  verifiedById  String?
  note          String?

  pet         Pet                @relation(fields: [petId], references: [id], onDelete: Cascade)
  requirement VaccineRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  verifiedBy  Staff?             @relation(fields: [verifiedById], references: [id])

  @@unique([petId, requirementId])
  @@index([expiresOn])
  @@map("pet_vaccinations")
}

enum CoatType {
  SHORT
  MEDIUM
  LONG
  DOUBLE
  CURLY
  WIRE
  HAIRLESS
}

// ─────────────────────────────────────────────
// STATIONS (grooming stations in the shop)
// ─────────────────────────────────────────────
model Station {
  id        String      @id @default(cuid())
  name      String // derived, never typed: role + next free number ("Bath 2")
  role      StationRole @default(GROOMER) // what this station is used for
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  // Who may work this station. Empty means anyone on staff.
  allowedRoles StaffRole[] @default([])

  // KENNEL stations only: the unit's physical layout. Kennel rows are
  // generated to fill this grid — see app/api/kennels.
  kennelRows    Int?
  kennelColumns Int?

  // KENNEL stations only: how many pets fit behind one of this unit's doors.
  // Groom tables and bathing stations always hold exactly one pet, which is
  // physical rather than a setting, so these are ignored for them. A bank of
  // small crates and a bank of walk-in runs are not the same size, which is
  // why this lives on the unit rather than on SystemConfig.
  kennelCapacityPerCompartment     Int @default(1)
  // Pets from ONE household may share a door beyond the rule above: a family
  // booking several small dogs is kennelled together on purpose. Unrelated
  // pets never exceed kennelCapacityPerCompartment.
  kennelHouseholdMaxPerCompartment Int @default(5)

  /// The paired reader's opaque device id. Stripe's `tmr_...`, Square's
  /// device_id and Clover's device id are all just strings.
  readerRef      String?
  /// Which mode it was paired in. A test reader is invisible to a live key,
  /// and `resource_missing` is not a message for somebody at a counter.
  readerLivemode Boolean?

  appointments    Appointment[]
  kennels         Kennel[]
  homeStaff       Staff[]          @relation("HomeStation")
  paymentAttempts PaymentAttempt[]

  @@map("stations")
}

enum StationRole {
  GROOMER // groom table
  BATHING // wash / bathing station
  DRYING // dryer or drying table — the step between the bath and the table
  KENNEL // a bank of kennels, laid out as a grid
  REGISTER
}

// ─────────────────────────────────────────────
// KENNELS (individual doors inside a KENNEL station)
// ─────────────────────────────────────────────
model Kennel {
  id        String   @id @default(cuid())
  stationId String
  row       Int // 1-based position in the unit grid
  column    Int // 1-based position in the unit grid
  label     String // what is written on the door, e.g. "A1"
  isActive  Boolean  @default(true) // false = out of service, cannot be occupied
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  station      Station       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  // Who is inside. A compartment holds as many pets as its unit allows —
  // see Station.kennelCapacityPerCompartment.
  appointments Appointment[]

  @@unique([stationId, row, column])
  @@unique([stationId, label])
  @@map("kennels")
}

// ─────────────────────────────────────────────
// SERVICE CATALOG (what the shop sells, and for how much)
// ─────────────────────────────────────────────
model Service {
  id String @id @default(cuid())

  // What kind of service this is, in the shop's own terms. `type` is the
  // narrow taxonomy appointments and reports have always used; it is derived
  // from the category so nobody has to pick from eleven near-identical values.
  category    ServiceCategory @default(GROOM)
  type        ServiceType
  name        String // customer-facing name, e.g. "Bath + Tidy"
  description String? // shown to customers
  staffNotes  String? // internal: how to do it, what to watch for. Never public.
  species     Species? // null = offered for any species

  // Dog pricing is by size; cats and add-ons use the flat price, optionally
  // with an upper bound so a range can be shown ("$55-$70"). Cents, always.
  priceSmallCents  Int?
  priceMediumCents Int?
  priceLargeCents  Int?
  priceXlCents     Int?
  priceFlatCents   Int?
  priceMaxCents    Int?

  // Size pricing can be driven from a single base price: the tiers are
  // recalculated as base x multiplier whenever the base moves, so raising
  // prices is one number per service instead of four.
  pricingMode      PricingMode @default(MANUAL)
  basePriceCents   Int?
  mediumMultiplier Float       @default(1.33)
  largeMultiplier  Float       @default(1.87)
  xlMultiplier     Float       @default(2.53)

  durationMins   Int?
  walkInEligible Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointmentServices AppointmentService[]
  promotions          Promotion[]

  // Not unique on [type, species]: Postgres does not dedupe NULL species, so
  // the constraint would only half work. Uniqueness is enforced on the name.
  @@unique([name])
  @@index([type])
  @@map("services")
}

enum ServiceCategory {
  GROOM // haircut and style
  BATH // wash, dry, brush out
  NAILS // trimming or grinding
  DENTAL // teeth
  EARS // ear cleaning
  ADD_ON // extras sold alongside a groom
  OTHER // anything else
}

enum PricingMode {
  MANUAL // every size typed in by hand
  BASE // small price is the base; the other sizes are derived from it
}

// Extra fees quoted alongside the catalog (matting, difficult handling, ...)
model Surcharge {
  id        String   @id @default(cuid())
  label     String
  minCents  Int?
  maxCents  Int?
  note      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charged AppointmentSurcharge[]

  @@map("surcharges")
}

/// An extra fee actually charged on one visit.
///
/// `Surcharge` has been a published range since it was written -- a matted coat
/// is $10-$30 depending on what is found on the table -- and nothing ever
/// attached one to a visit. The range is advisory: a genuinely awful coat is
/// charged above it and the row says so, because the counter has to explain the
/// number to an owner who was quoted something smaller.
model AppointmentSurcharge {
  id            String   @id @default(cuid())
  appointmentId String
  /// The catalog row this came from, kept for reporting. Null once the shop
  /// deletes the published fee; `label` is what the counter reads out.
  surchargeId   String?
  label         String
  amountCents   Int
  /// Charged above the published range. A fact on the row rather than something
  /// inferred later from a price list that has since changed.
  aboveRange    Boolean  @default(false)
  note          String?
  /// Who found it. Same reason.
  addedById     String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  surcharge   Surcharge?  @relation(fields: [surchargeId], references: [id], onDelete: SetNull)
  addedBy     Staff       @relation(fields: [addedById], references: [id])

  @@index([appointmentId])
  @@map("appointment_surcharges")
}

/// Money that changed hands somewhere else.
///
/// The shop takes payment on a Clover terminal this app does not integrate
/// with: staff read the amount off the screen, key it in, and record the result
/// here. No processor, no card data, no PCI surface. `reference` holds Clover's
/// transaction id, which is what a dispute is traced by and the only seam a
/// future integration would need.
model Payment {
  id            String           @id @default(cuid())
  appointmentId String
  method        PaymentMethod
  /// What was handed over, tip included -- the terminal's own total, so it
  /// reconciles against Clover's batch without arithmetic.
  amountCents   Int
  tipCents      Int              @default(0)
  reference     String?
  note          String?
  takenById     String
  takenAt       DateTime         @default(now())
  /// Null for the cash and checks the counter still types in.
  provider      PaymentProvider?
  attempt       PaymentAttempt?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  takenBy     Staff       @relation(fields: [takenById], references: [id])

  @@index([appointmentId])
  @@index([takenAt])
  @@map("payments")
}

enum PaymentMethod {
  CARD
  CASH
  CHECK
  OTHER
}

enum PaymentProvider {
  STRIPE
  CLOVER
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model PaymentAttempt {
  id             String               @id @default(cuid())
  appointmentId  String
  /// The register it was sent to. Kept as null rather than deleted if the
  /// station goes away -- the money still happened.
  stationId      String?
  provider       PaymentProvider
  /// The provider's id for the charge -- a Stripe PaymentIntent. Unique, so a
  /// retry can never produce a second attempt against one charge.
  providerRef    String               @unique
  /// Generated before the first call and reused on every retry of this
  /// attempt. Stripe replays the first response for 24 hours, so a timeout
  /// during "create intent" cannot charge a customer twice.
  idempotencyKey String               @unique
  /// What was asked for, before any tip the reader collects.
  amountCents    Int
  status         PaymentAttemptStatus @default(PENDING)
  /// From the provider. Only a card error is safe to read out to a customer;
  /// `customerSafe` is decided at settle time and is not stored.
  failureCode    String?
  failureMessage String?
  /// The row it became. Unique -- one attempt settles at most once.
  paymentId      String?              @unique
  startedById    String
  createdAt      DateTime             @default(now())
  settledAt      DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  station     Station?    @relation(fields: [stationId], references: [id], onDelete: SetNull)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  startedBy   Staff       @relation(fields: [startedById], references: [id])

  @@index([appointmentId])
  @@index([status, createdAt])
  @@map("payment_attempts")
}

// ─────────────────────────────────────────────
// MARKETING (promotions shown on the site and at the counter)
// ─────────────────────────────────────────────
model Promotion {
  id          String    @id @default(cuid())
  serviceId   String // a promotion always promotes one catalog service
  title       String
  body        String    @db.Text
  code        String? // promo code customers quote
  startsAt    DateTime?
  endsAt      DateTime? // exclusive
  isActive    Boolean   @default(true)
  showOnSite  Boolean   @default(true) // public pages
  showToStaff Boolean   @default(true) // counter script on the staff dashboard
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("promotions")
}

// ─────────────────────────────────────────────
// APPOINTMENTS
// ─────────────────────────────────────────────
model Appointment {
  id              String            @id @default(cuid())
  customerId      String
  petId           String
  stationId       String? // assigned when pet arrives / checked in
  staffId         String? // assigned groomer
  scheduledAt     DateTime // date + time of appointment (= arrival time for walk-ins)
  appointmentType AppointmentType   @default(APPOINTMENT)
  status          AppointmentStatus @default(SCHEDULED)
  serviceType     ServiceType
  durationMins    Int? // estimated duration in minutes
  visitNotes      String? // notes specific to this visit
  needsKennel     Boolean           @default(true) // holds a kennel for the visit
  checkedInAt     DateTime?
  completedAt     DateTime?

  // What this pet was actually groomed with, written down so the next groomer
  // repeats the cut instead of guessing at it. Per visit, never on the pet: a
  // coat taken short in June is not an instruction for September.
  groomBlade       String?
  groomShampoo     String?
  groomRecordNotes String?

  // What the owner agreed to when the groom could not be done as booked —
  // matting found on the table, a coat that has to come off. Snapshotted on
  // the visit, because agreeing once is not agreeing to the next one.
  consentRequestedAt DateTime?
  consentNote        String?   @db.Text // what was put to the owner, and the fee quoted
  consentGrantedAt   DateTime?
  consentDeclinedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer      Customer                   @relation(fields: [customerId], references: [id])
  pet           Pet                        @relation(fields: [petId], references: [id])
  station       Station?                   @relation(fields: [stationId], references: [id])
  staff         Staff?                     @relation(fields: [staffId], references: [id])
  services      AppointmentService[]
  statusHistory AppointmentStatusHistory[]
  visitEvents   VisitEvent[]
  photos        VisitPhoto[]
  // The compartment this pet is in, once it has been put away.
  kennelId      String?
  kenneledAt    DateTime?

  // The rate this visit was quoted under, snapshotted at booking. Editing a
  // tier later must not silently reprice a visit already quoted.
  pricingTierId        String?
  pricingDiscountCents Int?
  // A reward handed over against this visit, snapshotted like the rate above:
  // redeeming again later, or changing what a reward is worth, must never
  // reprice a visit the customer has already been quoted.
  rewardDiscountCents  Int     @default(0)

  kennel                Kennel?                @relation(fields: [kennelId], references: [id])
  pricingTier           PricingTier?           @relation(fields: [pricingTierId], references: [id], onDelete: SetNull)
  rewardEarning         RewardEarning?
  rewardRedemptions     RewardRedemption[]
  notifications         NotificationLog[]
  appointmentSurcharges AppointmentSurcharge[]
  payments              Payment[]
  paymentAttempts       PaymentAttempt[]

  @@index([scheduledAt, status])
  @@index([stationId, status])
  @@map("appointments")
}

/// What the shop has already told a customer about one visit, so a runner that
/// restarts does not say it twice. One row per kind per visit: the question is
/// "have we reminded them", and the channels are a record of what happened
/// rather than part of the key.
model NotificationLog {
  id            String           @id @default(cuid())
  /// Required, never nullable: Postgres does not treat two NULLs as equal in a
  /// unique index, so a nullable column would give a constraint that silently
  /// stops working. A kind that is not about one visit needs its own
  /// uniqueness decision rather than an inherited one that does not hold.
  appointmentId String
  customerId    String
  kind          NotificationKind
  /// Which channels it was sent down -- "EMAIL", "SMS". The row is claimed
  /// before the messages go, so this is what was attempted rather than what a
  /// carrier confirmed. An empty list is never written: a visit the shop has
  /// no way to reach is left unclaimed for a later run.
  channels      String[]
  sentAt        DateTime         @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Customer is part of the key because one freed slot is offered to several
  /// households. For the two kinds that are about the booking's own customer it
  /// changes nothing -- appointmentId already determines customerId there.
  @@unique([appointmentId, customerId, kind])
  @@index([customerId, sentAt])
  @@map("notification_logs")
}

enum NotificationKind {
  APPOINTMENT_REMINDER
  /// Anchored on the visit it is chasing -- the customer's last finished one --
  /// so the unique constraint reads "one prompt per completed visit" and there
  /// is no cooldown column to keep correct.
  REBOOKING_PROMPT
  /// "A slot has opened." Anchored on the CANCELLED visit that freed it, so the
  /// unique constraint reads "one offer per household per freed slot".
  SLOT_OFFER
}

// Services booked on one visit. `Appointment.serviceType` stays the primary
// service so existing screens and emails keep working; every service booked --
// including that one -- also has a row here.
model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  serviceId     String? // catalog row, if the service is still listed
  serviceType   ServiceType
  priceCents    Int? // snapshot of the quoted price
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([appointmentId, serviceId])
  @@index([serviceType])
  @@map("appointment_services")
}

enum AppointmentStatus {
  SCHEDULED // booked, not yet arrived
  CHECKED_IN // owner has checked in (online or in person)
  IN_PROGRESS // pet is being groomed
  DRYING // pet is drying / waiting between steps
  FINISHING // final touches
  COMPLETE // grooming done, not yet picked up
  READY_PICKUP // notified owner, waiting for pickup
  PICKED_UP // owner collected pet
  CANCELLED // appointment cancelled
  NO_SHOW // didn't show up
}

enum ServiceType {
  BATH_AND_TIDY // bath, blow-dry, brush out, tidy trim
  BATH_AND_TRIM // above + a full trim
  FULL_GROOM // full cut, style, bath
  LION_CUT // cat-specific — shaved body, fluffy head/paws/tail
  NAIL_TRIM // nails only
  NAIL_GRIND // nails ground smooth
  EAR_CLEANING // ears only
  TEETH_BRUSHING // teeth only
  GLAND_EXPRESSION // anal gland expression (walk-in)
  ADD_ON // misc add-on service
  CUSTOM // custom / consult
}

enum AppointmentType {
  APPOINTMENT // pre-booked via portal or by staff
  WALK_IN // customer arrived without a booking (portal check-in or in-person)
}

// ─────────────────────────────────────────────
// WAIVER ACCEPTANCES (per customer, per version)
// ─────────────────────────────────────────────
// ─────────────────────────────────────────────
// WAIVER REVISIONS (the published text of every version)
// ─────────────────────────────────────────────
model WaiverRevision {
  id          String   @id @default(cuid())
  version     String   @unique // matches SystemConfig.waiverVersion when published
  text        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? // staff member who published it

  createdBy Staff? @relation(fields: [createdById], references: [id])

  @@map("waiver_revisions")
}

model WaiverAcceptance {
  id            String   @id @default(cuid())
  customerId    String
  waiverVersion String // matches SystemConfig.waiverVersion at time of signing
  acceptedAt    DateTime @default(now())
  ipAddress     String? // for audit trail
  userAgent     String?

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, waiverVersion])
  @@map("waiver_acceptances")
}

// ─────────────────────────────────────────────
// VISIT EVENTS (mid-groom incidents per appointment)
// ─────────────────────────────────────────────
model VisitEvent {
  id            String         @id @default(cuid())
  appointmentId String
  eventType     VisitEventType
  occurredAt    DateTime       @default(now())
  loggedById    String? // staff who logged it
  note          String? // free-text details
  /// Tell the owner about this one. Off by default — an equipment fault is the
  /// shop's business — and what is ticked goes out with the ready-for-pickup
  /// message, which is the moment the owner is actually reading.
  ownerVisible  Boolean        @default(false)

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  loggedBy    Staff?      @relation(fields: [loggedById], references: [id])

  @@map("visit_events")
}

enum VisitEventType {
  HEALTH_FINDING // something noticed on the pet: ears, skin, lumps, fleas, teeth
  REWASH // pet defecated / urinated during groom, required re-wash
  BITE // pet bit a groomer — triggers hasBiteHistory flag on Pet
  BEHAVIORAL // growling, snapping, excessive stress (non-bite)
  INJURY // minor cut, nick, or other incident to the pet
  MATTING_FOUND // unexpected matting discovered mid-groom
  EQUIPMENT_ISSUE // clippers, dryer, etc. problem
  OTHER // catch-all, use note field for details
}

// Photographs of one day's work. They hang off the visit, not the pet:
// `Pet.photoId` is the face that identifies the dog, while a matted coat that
// had to come off and the cut it was taken to are both about one visit.
model VisitPhoto {
  id            String         @id @default(cuid())
  appointmentId String
  photoId       String
  kind          VisitPhotoKind
  /// What the groomer wants the next one to know. Optional: the kind and the
  /// picture usually say it.
  caption       String?
  /// Opt-*in*, like VisitEvent.ownerVisible. An ISSUE photo is often the
  /// shop's own evidence rather than something to send the owner.
  ownerVisible  Boolean        @default(false)
  takenById     String?
  createdAt     DateTime       @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  /// Not cascade on purpose: `deletePhotoIfUnused()` owns the bytes and must
  /// stay the only thing that frees a Photo row.
  photo       Photo       @relation(fields: [photoId], references: [id])
  takenBy     Staff?      @relation(fields: [takenById], references: [id])

  @@index([appointmentId, kind])
  @@map("visit_photos")
}

enum VisitPhotoKind {
  BEFORE // the coat as it arrived
  AFTER // the finished groom -- the cut the next groomer repeats
  ISSUE // matting, a hot ear, a split nail: what somebody noticed
}

// ─────────────────────────────────────────────
// APPOINTMENT STATUS HISTORY (audit trail)
// ─────────────────────────────────────────────
model AppointmentStatusHistory {
  id            String            @id @default(cuid())
  appointmentId String
  status        AppointmentStatus
  changedAt     DateTime          @default(now())
  changedById   String? // staff ID if staff changed it; null if system/customer
  note          String? // optional note on the transition

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  changedBy   Staff?      @relation(fields: [changedById], references: [id])

  @@map("appointment_status_history")
}

// ─────────────────────────────────────────────
// PRICING TIERS (legacy and negotiated rates)
// ─────────────────────────────────────────────

enum DiscountKind {
  PERCENT // a share off every line
  AMOUNT // a fixed sum off the visit
}

// A named rate the shop honours for a group of customers — the price agreed
// with someone in 2014, a staff rate, a rescue partnership.
//
// Defining the rate once rather than per customer is the point: "raise legacy
// rates by 5%" is one edit here, not a sweep through every profile. The
// discount is applied to the catalog price at quote time and snapshotted onto
// the visit, so changing a tier never reprices a visit already quoted.
model PricingTier {
  id              String       @id @default(cuid())
  name            String       @unique // "Legacy 2015", "Friends & family"
  discountKind    DiscountKind @default(PERCENT)
  discountPercent Float? // when PERCENT — 0–100
  discountCents   Int? // when AMOUNT — off the visit total
  note            String? // why this tier exists; shown to staff
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customers    Customer[]
  appointments Appointment[]

  @@map("pricing_tiers")
}

// ─────────────────────────────────────────────
// REWARDS (visit punch card)
// ─────────────────────────────────────────────

// One punch, earned by finishing a visit.
//
// There is no balance column anywhere: the punch count is the number of these
// rows, and what is available to redeem is derived against the redemptions
// below. A stored counter would drift the first time a visit was cancelled
// after it was marked complete.
//
// `appointmentId` is unique, which is what makes earning idempotent — a visit
// moves through COMPLETE, READY_PICKUP and PICKED_UP and each one tries.
model RewardEarning {
  id            String   @id @default(cuid())
  customerId    String
  appointmentId String   @unique
  earnedAt      DateTime @default(now())

  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("reward_earnings")
}

// A reward handed over at the counter. Who gave it, and what it was.
model RewardRedemption {
  id            String   @id @default(cuid())
  customerId    String
  staffId       String? // who handed it over
  label         String // snapshot of the reward on offer at the time
  // What it was worth when it was handed over, and the visit it came off.
  // Both are snapshots: the shop can change the reward's value tomorrow.
  valueCents    Int      @default(0)
  appointmentId String?
  note          String?
  redeemedAt    DateTime @default(now())

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff       Staff?       @relation(fields: [staffId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([customerId])
  // Declared here because 20260825000000_reward_cash_value created it and the
  // model never said so — the next migration Prisma generated after that
  // proposed dropping it as drift. rewards.ts looks a redemption up by the
  // visit it came off, so the index is wanted; the schema just has to say it.
  @@index([appointmentId])
  @@map("reward_redemptions")
}

// ─────────────────────────────────────────────
// PASSWORD RESETS
// ─────────────────────────────────────────────
/// A pending "forgot my password" link.
///
/// Both sign-in tables are covered by one model: `Customer` and `Staff` are
/// separate tables with separate unique emails, so the subject says which one a
/// row belongs to rather than pointing a foreign key at one of them.
///
/// Only the *hash* of the token is stored. The token itself exists in the link
/// that went out and nowhere else, so a copy of this table cannot be replayed
/// into somebody's account.
model PasswordReset {
  id        String               @id @default(cuid())
  tokenHash String               @unique // sha256 of the token in the emailed link
  subject   PasswordResetSubject
  subjectId String
  expiresAt DateTime
  /// Set the moment the link is spent. A used row is kept rather than deleted:
  /// "that link has already been used" is a different answer from "no such
  /// link", and it is the one that tells someone their reset already happened.
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([subject, subjectId])
  @@index([expiresAt])
  @@map("password_resets")
}

enum PasswordResetSubject {
  CUSTOMER
  STAFF
}

/// Addresses already placed on a map.
///
/// OpenStreetMap's Nominatim is keyless but rate-limited and asks not to be
/// hammered, so every lookup is kept here for good. A row with null
/// coordinates is a remembered miss — retried a day later, not every render.
model GeocodeCache {
  query     String   @id // normalised address: trimmed, collapsed, lowercased
  lat       Float?
  lon       Float?
  label     String? // what Nominatim called the place
  checkedAt DateTime @default(now()) @updatedAt

  @@map("geocode_cache")
}

/// A shop insight somebody has dealt with.
///
/// Derived observations have no state of their own -- `shopInsights()` works
/// them out from the diary every time it is asked -- so "we know, we have
/// handled it" had nowhere to live and the same line sat on the dashboard for
/// a fortnight being scrolled past. This is that acknowledgement.
///
/// Deliberately a snooze and never a permanent dismissal: the insight is a live
/// reading, so if the condition comes back the shop wants to hear about it
/// again. A "never show me this" on a derived signal is how a dashboard becomes
/// decoration.
model InsightDecision {
  id           String   @id @default(cuid())
  /// The insight's stable id from lib/insights.ts, e.g. "anomaly-no-shows".
  insightId    String   @unique
  /// Shop-local instant the observation comes back into view.
  snoozedUntil DateTime
  /// What the insight said when it was snoozed, so the audit reads on its own
  /// once the underlying numbers have moved.
  title        String
  decidedById  String?
  decidedAt    DateTime @default(now())

  decidedBy Staff? @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([snoozedUntil])
  @@map("insight_decisions")
}
