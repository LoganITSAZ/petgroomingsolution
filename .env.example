# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@db:5432/gentlegroomer"

# ─── NextAuth ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="https://gentlegroomer.net"

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Gentle Groomer <no-reply@gentlegroomer.net>"

# ─── SMS (Twilio — optional, leave blank to disable) ────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ─── App ────────────────────────────────────────────────────
NODE_ENV="production"
