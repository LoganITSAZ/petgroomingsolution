# ─── Required ───────────────────────────────────────────────
# Password for the bundled Postgres container.
POSTGRES_PASSWORD="change-me"

# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# ─── Recommended ────────────────────────────────────────────
# Shop identity. These values are used only on first boot; edit existing shop
# details in Admin after deployment.
SHOP_NAME="Your Grooming Shop"
SHOP_TAGLINE="The best and bubbliest groomer in town"
SHOP_PHONE=""
SHOP_EMAIL=""
SHOP_ADDRESS=""
SHOP_WEBSITE=""
# Required on first boot — the seed refuses to create the first admin without
# ADMIN_PASSWORD (min 8 chars) rather than inventing one nobody was told about.
# Ignored once any staff account exists; reset with `npm run staff:password`.
ADMIN_EMAIL="admin@yourshop.com"
ADMIN_PASSWORD=""

# Public URL of the site. Defaults to http://localhost.
NEXTAUTH_URL="https://your-domain.example"

# Serve HTTPS instead of plain HTTP (certificates must already exist in
# /etc/letsencrypt): NGINX_CONF="./nginx.tls.conf"
NGINX_CONF="./nginx.conf"

# ─── Optional ───────────────────────────────────────────────
# Email delivery. Without a key, notification emails are skipped silently.
RESEND_API_KEY=""
EMAIL_FROM="Your Grooming Shop <no-reply@yourshop.com>"

# Set to false to stop the baseline seed running on every deploy. The seed is
# idempotent, so leaving it on is safe.
SEED_ON_START="true"

# ─── Local development only ─────────────────────────────────
# Used by .env.local when running `npm run dev` against `docker compose up db`.
# DATABASE_URL="postgresql://postgres:change-me@localhost:5432/gentlegroomer"
#
# `next dev` only answers cross-origin requests from hosts it knows. The
# machine's own LAN IPv4 addresses are added automatically; set this (comma-
# separated) for a hostname or tunnel it cannot see itself. Unused in prod.
# DEV_ORIGINS="grooming.local,shop-pi"
